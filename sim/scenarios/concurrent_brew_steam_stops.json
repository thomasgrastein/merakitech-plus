{
  "name": "concurrent_brew_steam_stops",
  "description": "v6.20: independent MANUAL stops with brew + latched steam. (1) UI starts brew, then steam (relaxed guard). (2) STOP STEAM mid-brew: only word24=0 is written; steam stops, the brew continues (EXTRACTION, HOLD·STEAM offered again). (3) Steam started a second time by a direct word24=1 write (the stock-equivalent register path, set_reg). (4) STOP BREW while steaming: only word22=0; the brew stops, latched steam continues (0x4121, STOP STEAM only). (5) STOP STEAM ends it.",
  "duration_s": 30,
  "ui_only": true,
  "events": [
    {
      "t": 1,
      "target": "ui",
      "cmd": "action",
      "name": "brew"
    },
    {
      "t": 0.5,
      "target": "sim",
      "event": {
        "type": "milk_jump",
        "value": 120
      }
    },
    {
      "t": 6,
      "target": "ui",
      "cmd": "action",
      "name": "steam"
    },
    {
      "t": 10,
      "target": "ui",
      "cmd": "action",
      "name": "steam_stop"
    },
    {
      "t": 11,
      "target": "runner",
      "op": "snapshot",
      "label": "steam-stopped-brew-runs"
    },
    {
      "t": 14,
      "target": "sim",
      "event": {
        "type": "set_reg",
        "word": 24,
        "value": 1
      }
    },
    {
      "t": 17,
      "target": "ui",
      "cmd": "action",
      "name": "brew_stop"
    },
    {
      "t": 20,
      "target": "runner",
      "op": "snapshot",
      "label": "brew-stopped-steam-runs"
    },
    {
      "t": 23,
      "target": "ui",
      "cmd": "action",
      "name": "steam_stop"
    }
  ],
  "expect": [
    {
      "kind": "sim_log",
      "assert": "activity_start",
      "activity": "steam",
      "t0": 6,
      "t1": 7
    },
    {
      "kind": "work_sta_seen",
      "t0": 7,
      "t1": 10,
      "value": "0x5327"
    },
    {
      "kind": "state",
      "path": "stop.btns",
      "t": 8.5,
      "window": 1,
      "equals": [
        "brew",
        "steam"
      ]
    },
    {
      "kind": "sim_log",
      "assert": "write_words",
      "sub": 24,
      "words": [
        0,
        650,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "t0": 9.9,
      "t1": 10.6
    },
    {
      "kind": "sim_log",
      "assert": "activity_stop",
      "activity": "steam",
      "reason_contains": "manual",
      "t0": 10,
      "t1": 11.5
    },
    {
      "kind": "sim_log",
      "assert": "no_write_word",
      "word": 22,
      "t0": 1.5,
      "t1": 16.9
    },
    {
      "kind": "stop_ok",
      "t0": 10,
      "t1": 13,
      "min": 1,
      "max_fail": 0
    },
    {
      "kind": "phase",
      "t": 12,
      "window": 1,
      "value": "EXT"
    },
    {
      "kind": "state",
      "path": "stop.btns",
      "t": 12.5,
      "window": 1,
      "equals": [
        "brew"
      ]
    },
    {
      "kind": "state",
      "path": "stop.steam_hold",
      "t": 12.5,
      "window": 1,
      "equals": "on"
    },
    {
      "kind": "sim_log",
      "assert": "activity_start",
      "activity": "steam",
      "t0": 14,
      "t1": 15
    },
    {
      "kind": "work_sta_seen",
      "t0": 15,
      "t1": 17,
      "value": "0x5327"
    },
    {
      "kind": "state",
      "path": "steam.kind",
      "t": 16,
      "window": 0.8,
      "equals": "auto"
    },
    {
      "kind": "sim_log",
      "assert": "write_words",
      "sub": 22,
      "words": [
        0
      ],
      "t0": 16.9,
      "t1": 17.6
    },
    {
      "kind": "sim_log",
      "assert": "activity_stop",
      "activity": "brew",
      "reason_contains": "manual",
      "t0": 17,
      "t1": 18.5
    },
    {
      "kind": "stop_ok",
      "t0": 17,
      "t1": 21,
      "min": 2,
      "max_fail": 0
    },
    {
      "kind": "work_sta_seen",
      "t0": 19,
      "t1": 22.5,
      "value": "0x4121"
    },
    {
      "kind": "phase",
      "t": 21,
      "window": 1,
      "value": "STEAM"
    },
    {
      "kind": "state",
      "path": "stop.btns",
      "t": 21,
      "window": 1,
      "equals": [
        "steam"
      ]
    },
    {
      "kind": "word",
      "word": 24,
      "t": 21,
      "window": 1,
      "value": 1
    },
    {
      "kind": "sim_log",
      "assert": "no_write_word",
      "word": 24,
      "t0": 10.6,
      "t1": 30
    },
    {
      "kind": "sim_log",
      "assert": "activity_stop",
      "activity": "steam",
      "reason_contains": "manual",
      "t0": 23,
      "t1": 24.5
    },
    {
      "kind": "stop_ok",
      "t0": 23,
      "t1": 27,
      "min": 3,
      "max_fail": 0
    },
    {
      "kind": "phase",
      "t": 29,
      "window": 1,
      "value": "READY"
    }
  ]
}
